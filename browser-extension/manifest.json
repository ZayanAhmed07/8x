{
  "manifest_version": 3,
  "name": "Tally for Meet",
  "version": "1.0.0",
  "description": "Tells Tally Capture who is speaking in Google Meet, so your transcript has real names instead of \"Others on the call\".",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Tally for Meet", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png" } },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47821/*"]
}
